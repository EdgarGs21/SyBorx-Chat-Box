# ==============================================================================
# CONFIGURACIÓN DEL SERVIDOR
# ==============================================================================
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ==============================================================================
# BASE DE DATOS (POSTGRESQL)
# ==============================================================================
# Cadena de conexión completa para PostgreSQL
DATABASE_URL=postgresql://chatbot_user:chatbot_pass123@localhost:5432/chatbot_db

# Parámetros individuales (útiles para scripts y docker)
DB_HOST=localhost
DB_PORT=5432
DB_USER=chatbot_user
DB_PASSWORD=chatbot_pass123
DB_NAME=chatbot_db

# ==============================================================================
# INTELIGENCIA ARTIFICIAL (GOOGLE GEMINI)
# ==============================================================================
IA_PROVIDER=gemini
GEMINI_API_KEY=tu_gemini_api_key_aqui
GEMINI_MODEL=gemini-2.0-flash

# ==============================================================================
# SEGURIDAD Y ALMACENAMIENTO
# ==============================================================================
JWT_SECRET=super_secret_jwt_key_change_in_production
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5
